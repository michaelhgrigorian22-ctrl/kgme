#!/bin/sh
# post-commit (HANDOFF-0040). Starts `kgme sync` in the background: it commits logs/ledger/
# if a foreign event is new and pushes what is ahead, so the remote never sits behind. The
# commit returns at once (Michou, 2026-10-09: hook backgrounded); the run's lines go to
# logs/scratch/sync.log and a failure to start goes to logs/scratch/hook-errors.jsonl, which
# `make check` reads. Never prompts, never overwrites the remote. Enabled by `make setup`,
# which sets `core.hooksPath control/git-hooks`; `make check` fails when it is unset.
#
# A hook runs with a bare environment: PATH is set here so `uv` (~/.local/bin) and `gh`, the
# HTTPS credential helper (/opt/homebrew/bin), resolve (lesson of 2026-09-11, AUDIT-0009).
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export PATH
GIT_TERMINAL_PROMPT=0
export GIT_TERMINAL_PROMPT
# A ledger commit made by `kgme sync` carries KGME_SYNC_RUN: that run pushes, so this hook
# does not, and a push is attempted once per run (review cycle 1, F1).
if [ -n "$KGME_SYNC_RUN" ]; then exit 0; fi
repo="$(git rev-parse --show-toplevel)" || exit 0
dir="$repo/logs/scratch"
mkdir -p "$dir"
# The atlas (HANDOFF-0051) after every commit, on any branch: it is local and pushes nothing.
# A checkout whose code predates it (no kgme/atlas.py) skips it; a failure is its own
# transient ledger note, never a failed commit (review cycle 1 F3).
atlas() {
  if [ -f "$repo/kgme/atlas.py" ]; then uv run --frozen --project "$repo" kgme atlas; fi
}
# The design track lands on main (HANDOFF-0055): after the atlas, on main (Claude Code's
# commits) and on design (Codex's), `kgme merge design` merges a green, in-lane design commit
# into the main checkout at a quiet point; a run with nothing to do writes nothing. A checkout
# whose code predates it (no kgme/merge.py) skips it.
merge() {
  # The main checkout's code, whichever checkout committed: the design branch never holds
  # kgme/merge.py, so a check of the committing checkout would skip every design commit.
  main="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  main="${main%/.git}"
  if [ -f "$main/kgme/merge.py" ]; then
    uv run --frozen --project "$main" kgme merge design --base "$repo"
  fi
}
# Only main is pushed by a hook: the design branch, and any other, is Michou's to push
# (HANDOFF-0049 review cycle 1 F1, Cowork's ruling). Off main, the atlas runs, and on design the merge.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$branch" != "main" ]; then
  ( trap '' HUP; atlas; if [ "$branch" = "design" ]; then merge; fi ) >> "$dir/atlas.log" 2>&1 &
  exit 0
fi
(
  trap '' HUP
  uv run --frozen --project "$repo" kgme sync --base "$repo"
  code=$?
  if [ "$code" -ne 0 ]; then
    printf '{"ts":"%s","error":"post-commit: kgme sync exited %s"}\n' \
      "$(date +%Y-%m-%dT%H:%M:%S%z)" "$code" >> "$dir/hook-errors.jsonl"
  fi
  atlas  # after the push
  merge  # after the atlas
) >> "$dir/sync.log" 2>&1 &
exit 0
