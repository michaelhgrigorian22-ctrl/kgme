{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit({outputs})",
      "Bash(make check)",
      "Bash(uv run --frozen pytest *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git add {outputs})",
      "Bash(git commit {outputs})",
      "Bash(uv run --frozen --project {main} kgme review *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "{outputs}"
      ]
    },
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "uv run --frozen --project {main} kgme review *"
    ]
  }
}
