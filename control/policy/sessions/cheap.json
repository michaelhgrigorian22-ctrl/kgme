{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(/{repo}/**)",
      "Bash(uv run --frozen pytest *)",
      "Bash(git diff *)",
      "Bash(git status *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "{repo}"
      ]
    },
    "network": {
      "allowedDomains": [],
      "strictAllowlist": true
    }
  }
}
