# KGME — proposed .gitignore (Claude Code confirms at git init)
.DS_Store
.env
.env.*
# logs/ledger/*.jsonl are DURABLE and tracked (ADR-012); only scratch logs are ignored
logs/scratch/
# logs/trace/ is the untracked read-only tool stream (ADR-019 §2); test streams never enter git
logs/trace/
logs/ledger-test/
logs/trace-test/
logs/scratch-test/
# Obsidian's vault is the repository from HANDOFF-0051; its per-machine state stays untracked
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
memory/.obsidian/workspace.json
memory/.obsidian/workspace-mobile.json
memory/.obsidian/cache/
# the atlas: a view regenerated from the tree on every commit, never edited (HANDOFF-0051)
atlas/
memory/attachments/*.tmp
# copies kgme capture keeps beside a file it adds a line to, removed by `kgme clean kept`
memory/**/.*.capture-*
# Claude Code regenerates a mod's tsconfig.json, as it does its .claude-plugin/types/ (HANDOFF-0074)
mods/*/tsconfig.json
__pycache__/
.venv/
*.pyc
# Tier 1 must never be here; this line is a tripwire, not a permission
memory/private/
.Rhistory
.RData
# Backblaze restore staging (Michou, 2026-09-11); restored files are never committed
KGME_BB_RESTORATIONS/
