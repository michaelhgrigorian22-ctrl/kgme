# KGME — proposed .gitignore (Claude Code confirms at git init)
.DS_Store
.env
.env.*
# logs/ledger/*.jsonl are DURABLE and tracked (ADR-012); only scratch logs are ignored
logs/scratch/
# logs/trace/ is the untracked read-only tool stream (ADR-019 §2); test streams never enter git
logs/trace/
logs/ledger-test/
logs/trace-test/
memory/.obsidian/workspace.json
memory/.obsidian/workspace-mobile.json
memory/.obsidian/cache/
memory/attachments/*.tmp
__pycache__/
.venv/
*.pyc
# Tier 1 must never be here; this line is a tripwire, not a permission
memory/private/
.Rhistory
.RData
# Backblaze restore staging (Michou, 2026-09-11); restored files are never committed
KGME_BB_RESTORATIONS/
