{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(uv run *)",
      "Bash(make check)",
      "Bash(make canary-agents)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Read",
      "Edit(/kgme/**)",
      "Edit(/tests/**)",
      "Edit(/jobs/**)",
      "Edit(/cockpit/**)",
      "Edit(/memory/agent/**)",
      "Edit(/logs/**)",
      "Edit(/docs/audit/**)",
      "Edit(/docs/handoff/proposed/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(security *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git branch -D*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(~/.ssh/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(memory/private/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/*.md)",
      "Edit(/docs/adr/**)",
      "Edit(/docs/plans/**)",
      "Edit(/docs/readers/**)",
      "Edit(/docs/archive/**)",
      "Edit(/docs/handoff/*.md)",
      "Edit(/memory/notes/**)",
      "Edit(/memory/inbox/**)",
      "Edit(/memory/daily/**)",
      "Edit(/control/**)",
      "Edit(/.claude/**)",
      "Edit(/kgme.toml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/control/hooks/pre_tool_guard.sh",
            "timeout": 5,
            "statusMessage": "KGME guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/control/hooks/post_tool_ledger.sh",
            "timeout": 10,
            "statusMessage": "KGME ledger"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/control/hooks/session_end_sync.sh",
            "timeout": 120,
            "statusMessage": "KGME sync"
          }
        ]
      }
    ]
  }
}
